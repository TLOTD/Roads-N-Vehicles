{
	"schemaVersion": 1,
	"id": "roads-n-vehicles",
	"version": "${version}",
	"name": "TLOTD: Roads 'n' Vehicles",
	"description": "A small mod, that adds asphalt (with and without markings), guardrails, delineators and a whole bunch of european street signs.",
	"authors": [
		"TLOTD",
		"Isla_Nublar"
	],
	"contact": {
		"homepage": "https://modrinth.com/mod/roads-n-vehicles",
		"sources": "https://github.com/tlotd/Roads-N-Vehicles"
	},
	"license": "CC-BY-NC-SA-4.0",
	"icon": "assets/roads-n-vehicles/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"net.tlotd.roads_n_vehicles.TLOTDRoadsnVehicles"
		],
		"client": [
			"net.tlotd.roads_n_vehicles.TLOTDRoadsnVehiclesClient"
		],
		"fabric-datagen": [
			"net.tlotd.roads_n_vehicles.TLOTDRoadsnVehiclesDataGenerator"
		],
		"jade": [
			"net.tlotd.roads_n_vehicles.compat.jade.TLOTDRoadsnVehiclesJadeIntegration"
		]
	},
	"mixins": [
		"roads-n-vehicles.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*"
	},
	"suggests": {
		"tlotd": ">=0.4.3"
	},
	"custom": {
		"modmenu": {
			"parent": {
				"id": "tlotd",
				"name": "TLOTD",
				"description": "Compatible with all versions of our main mod: TLOTD.",
				"icon": "assets/roads-n-vehicles/tlotd_icon.png"
			},
			"links": {
				"modmenu.tlotd": "https://tlotd.net/u/tlotd",
				"modmenu.modrinth": "https://modrinth.com/mod/roads-n-vehicles",
				"modmenu.discord": "https://tlotd.net/discord",
				"modmenu.reddit": "https://www.reddit.com/r/tlotd/"
			}
		}
	}
}